rules_version = '2';
// HINT 2기 운영포털 Firestore 규칙(2기 전용 Firebase 프로젝트 hint-knewdeal-2). 사용자가 2기 콘솔에 게시합니다.
// 기본은 막힘(아래에 적힌 경로만 열림). 반 1~16, 날짜 2026-10-28~2027-01-22(cohort.json과 같음, checkhere/tests/firestore-rules-2.test.mjs가 확인).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;}
    function email(){return request.auth.token.email;}
    function bootstrapEmail(e){return e=='hint.kpc@gmail.com'||e=='kpc.jtkim@gmail.com';}
    function bootstrapAdmin(){return signedIn()&&bootstrapEmail(email());}
    function profileExists(){return signedIn()&&exists(/databases/$(database)/documents/users/$(email()));}
    function profile(){return get(/databases/$(database)/documents/users/$(email())).data;}
    function isAdmin(){return bootstrapAdmin()||(profileExists()&&profile().get('active',true)==true&&profile().get('role','')=='ADMIN');}
    function isTeacher(){return profileExists()&&profile().get('active',false)==true&&profile().get('role','')=='TEACHER';}
    function checkhereApprover(){return signedIn() && email()=='hint.kpc@gmail.com' && request.auth.token.firebase.sign_in_provider=='google.com';}
    // 2기 반 번호·교육 기간
    function validClass(c){return c is string && c.matches('([1-9]|1[0-6])');}
    function courseDate(d){return d is string && d.matches('202[67]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') && d>='2026-10-28' && d<='2027-01-22';}
    // 담임은 자기 반만: users/{email}의 기본담당(primaryClassId·classId)과 임시담당(tempClassIds·classIds)
    function ownsClass(classId){
      let p = profile();
      return isTeacher() && validClass(classId) && (classId == p.get('primaryClassId','') || classId == p.get('classId','')
        || (p.get('tempClassIds',[]) is list && classId in p.get('tempClassIds',[])) || (p.get('classIds',[]) is list && classId in p.get('classIds',[])));
    }
    function validChanges(c){
      return c is map && c.keys().size()>0 && c.keys().hasOnly(['entry','exit','entryMemo','exitMemo'])
        && (!('entry' in c) || (c.entry is string && c.entry.matches('([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]')))
        && (!('exit' in c) || (c.exit is string && c.exit.matches('([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]')))
        && (!('entryMemo' in c) || (c.entryMemo is string && c.entryMemo.size()<=500))
        && (!('exitMemo' in c) || (c.exitMemo is string && c.exitMemo.size()<=500));
    }
    // CheckHere time deletion: only sides listed in deleteTimes may be '' (administrators only).
    function hhmmss(v){return v is string && v.matches('([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]');}
    function memoOk(c,k){return !(k in c) || (c[k] is string && c[k].size()<=500);}
    function reqTimeOk(c,d,k){return (!(k in c) && !(k in d)) || ((k in c) && hhmmss(c[k]) && !(k in d)) || ((k in c) && c[k]=='' && (k in d));}
    function deletedMemoBlank(c,d,k,m){return !(k in d) || !(m in c) || c[m]=='';}
    function validRequestChanges(c,d){return c is map && c.keys().size()>0 && c.keys().hasOnly(['entry','exit','entryMemo','exitMemo']) && d is list && d.size()<=2 && d.hasOnly(['entry','exit']) && reqTimeOk(c,d,'entry') && reqTimeOk(c,d,'exit') && memoOk(c,'entryMemo') && memoOk(c,'exitMemo') && deletedMemoBlank(c,d,'entry','entryMemo') && deletedMemoBlank(c,d,'exit','exitMemo');}
    function afterTimeOk(a,d,k){return ((k in d) && (k in a) && a[k]=='') || (!(k in d) && (!(k in a) || hhmmss(a[k])));}
    function validAfter(a,d){return a is map && a.keys().size()>0 && a.keys().hasOnly(['entry','exit','entryMemo','exitMemo']) && d is list && afterTimeOk(a,d,'entry') && afterTimeOk(a,d,'exit') && memoOk(a,'entryMemo') && memoOk(a,'exitMemo');}

    match /checkhereRequests/{requestId}{
      allow read: if isAdmin() || (resource.data.createdBy==email() && ownsClass(resource.data.classId));
      allow create: if signedIn()
        && (isAdmin() || ownsClass(request.resource.data.classId))
        && request.resource.data.keys().hasOnly(['classId','date','name','phoneLast4','reason','changes','deleteTimes','createdBy','createdAt','updatedAt','status'])
        && validClass(request.resource.data.classId) && courseDate(request.resource.data.date)
        && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=60
        && request.resource.data.phoneLast4 is string && request.resource.data.phoneLast4.matches('([0-9]{4})?')
        && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=1000
        && (!('deleteTimes' in request.resource.data) || (isAdmin() && request.resource.data.deleteTimes is list && request.resource.data.deleteTimes.size()>0))
        && validRequestChanges(request.resource.data.changes, request.resource.data.get('deleteTimes',[]))
        && request.resource.data.createdBy==email() && request.resource.data.status=='pending'
        && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
      allow update: if checkhereApprover() && request.resource.data.updatedAt==request.time && (
        (resource.data.status=='pending' && request.resource.data.status=='approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approval','approvedBy','approvedAt','updatedAt'])
          && request.resource.data.approvedBy==email() && request.resource.data.approvedAt==request.time
          && request.resource.data.approval is map
          && request.resource.data.approval.keys().hasOnly(['recordId','version','before','after','reason'])
          && request.resource.data.approval.recordId is string && request.resource.data.approval.version is string
          && request.resource.data.approval.reason==resource.data.reason
          && validAfter(request.resource.data.approval.after, resource.data.get('deleteTimes',[])))
        || (resource.data.status=='pending' && request.resource.data.status=='rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','updatedAt'])
          && request.resource.data.reviewedBy==email() && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size()>0 && request.resource.data.reviewNote.size()<=1000)
        || (resource.data.status=='approved' && request.resource.data.status=='applying'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attemptId','updatedAt'])
          && request.resource.data.attemptId is string && request.resource.data.attemptId.size()>=16)
        || (resource.data.status=='applying' && request.resource.data.status in ['verified','partial','failed','unknown','conflict']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','result','updatedAt'])
          && request.resource.data.result is map && request.resource.data.result.message is string)
      );
      // Only pending requests can be withdrawn; request contents remain immutable.
      allow update: if signedIn()
        && resource.data.createdBy==email()
        && (isAdmin() || ownsClass(resource.data.classId))
        && resource.data.status=='pending' && request.resource.data.status=='withdrawn'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnBy','withdrawnAt','updatedAt'])
        && request.resource.data.withdrawnBy==email()
        && request.resource.data.withdrawnAt==request.time && request.resource.data.updatedAt==request.time;
      allow delete: if false;
    }
    match /users/{userEmail}{
      allow read: if isAdmin() || (signedIn() && email()==userEmail);
      allow create, update, delete: if isAdmin();
    }
    match /classes/{classId}{
      allow read: if isAdmin() || ownsClass(classId);
      allow create, update: if isAdmin() && validClass(classId);
      allow delete: if false;
      match /checkhereSnapshots/{snapshotId}{
        allow read: if isAdmin();
        allow create: if isAdmin() && validClass(classId)
          && request.resource.data.classId == classId
          && request.resource.data.createdBy == email()
          && request.resource.data.records is list
          && request.resource.data.records.size() <= 1000;
        allow update, delete: if false;
      }
      // Same administrator-only source access; one bounded latest document per day.
      match /checkhereCurrent/{date}{
        allow read: if isAdmin();
        allow create, update: if isAdmin() && validClass(classId) && courseDate(date)
          && request.resource.data.classId == classId && request.resource.data.date == date
          && request.resource.data.keys().hasOnly(['classId','date','records','jobId','updatedBy','updatedAt'])
          && request.resource.data.records is list && request.resource.data.records.size() <= 1000
          && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /customLinks/{linkId}{
        allow read: if isAdmin() || ownsClass(classId);
        allow create, update, delete: if (isAdmin() || ownsClass(classId)) && validClass(classId);
      }
    }
    // 체크히어 이름 연결(반별 학생 이름·전화 끝 4자리·체크히어 학생 번호). 개인정보라 관리자만 읽고 씁니다.
    match /checkhereIdentities/{classId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validClass(classId)
        && request.resource.data.keys().hasOnly(['classId','students','updatedBy','updatedAt'])
        && request.resource.data.classId == classId
        && request.resource.data.students is list && request.resource.data.students.size() <= 40
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // 알림(notify.mjs·notify-core.mjs notificationDoc, 사용자 요청 2026-10-19): {kind,title,body,cls,link,to:[이메일 ≤10],toRole?:'admin',toClass?:'N',from,createdAt,readBy:[이메일]}.
    // 받는 사람: to에 든 이메일, toRole 'admin'이면 운영자, toClass면 그 반 담임. 운영자는 모두 읽음. 담임은 운영자에게(toRole admin) 또는 자기 반으로만 보냅니다.
    // 읽음 표시는 readBy에 내 이메일 하나만 더합니다(arrayUnion). 지우기는 없음.
    function notifyRecipient(d){return email() in d.get('to',[]) || (d.get('toRole','')=='admin' && isAdmin()) || ('toClass' in d && ownsClass(d.toClass));}
    function validNotification(d){
      return d.keys().hasOnly(['kind','title','body','cls','link','to','toRole','toClass','from','createdAt','readBy'])
        && d.kind in ['서류발급','민원','출결대조 메모']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.body is string && d.body.size() <= 160
        && d.cls is string && (d.cls == '' || validClass(d.cls))
        && d.link is string && d.link.size() <= 200
        && d.to is list && d.to.size() <= 10
        && d.from == email() && d.readBy is list && d.readBy.size() == 1 && email() in d.readBy
        && (!('toRole' in d) || d.toRole == 'admin')
        && (!('toClass' in d) || validClass(d.toClass))
        && (d.to.size() > 0 || 'toRole' in d || 'toClass' in d)
        && d.createdAt == request.time;
    }
    match /notifications/{notificationId}{
      allow read: if signedIn() && (isAdmin() || notifyRecipient(resource.data));
      allow create: if signedIn() && (isAdmin() || isTeacher()) && validNotification(request.resource.data)
        && (isAdmin() || ((request.resource.data.cls == '' || ownsClass(request.resource.data.cls))
          && ('toRole' in request.resource.data || 'toClass' in request.resource.data)
          && (!('toClass' in request.resource.data) || ownsClass(request.resource.data.toClass))));
      allow update: if signedIn() && (isAdmin() || notifyRecipient(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
        && request.resource.data.readBy.hasAll(resource.data.readBy) && email() in request.resource.data.readBy;
      allow delete: if false;
    }
    // Timetable data is isolated from attendance and class settings.
    function validTimetable(classId){
      return request.resource.data.classId == classId
        && validClass(classId)
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 500
        && request.resource.data.revision is int
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
    }
    match /timetableBetaDrafts/{classId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validTimetable(classId);
      allow delete: if false;
    }
    match /timetableBetaPublished/{classId}{
      allow read: if isAdmin() || ownsClass(classId);
      allow create, update: if isAdmin() && validTimetable(classId);
      allow delete: if false;
    }
    match /timetableBetaInstructors/{instructorId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.name is string
        && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100
        && request.resource.data.keys().hasOnly(['name','organization','phone','note','revision','updatedBy','updatedAt'])
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // CheckHere proposals remain private to administrators. Sources are immutable.
    match /checkhereProposalDrafts/{draftId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && validClass(request.resource.data.classId)
        && courseDate(request.resource.data.date)
        && request.resource.data.students is map
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /checkhereProposalSources/{sourceId}{
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.requestId is string
        && request.resource.data.record is map
        && validChanges(request.resource.data.changes)
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    // Survey results: own-class reads, administrator writes.
    match /surveyBetaSummaries/{classId}/surveys/{eventId}{
      allow read: if isAdmin() || ownsClass(classId);
      allow create, update: if isAdmin()
        && validClass(classId)
        && request.resource.data.classId == classId
        && request.resource.data.eventId == eventId
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['classId','eventId','title','date','sourceId','url','syncedAt','scheduleFingerprint','answered','missing','review','excluded','unknown','invalidCount','duplicateCount','eligibleCount','scores','attendanceFingerprint','updatedBy','updatedAt'])
        && request.resource.data.answered is list && request.resource.data.answered.size() <= 100
        && request.resource.data.missing is list && request.resource.data.missing.size() <= 100
        && request.resource.data.review is list && request.resource.data.review.size() <= 100
        && request.resource.data.excluded is list && request.resource.data.excluded.size() <= 100
        && request.resource.data.unknown is list && request.resource.data.unknown.size() <= 500;
      allow delete: if false;
    }
    // Class-scoped portal attendance derivation. Original Sheets remain unchanged.
    match /attendanceBetaSummaries/{classId}{
      allow read: if isAdmin() || ownsClass(classId);
      allow create, update: if isAdmin()
        && validClass(classId)
        && request.resource.data.classId == classId
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['classId','version','asOf','latestDate','latestEntered','dates','students','fingerprint','syncedAt','updatedBy','updatedAt'])
        && request.resource.data.students is list && request.resource.data.students.size() <= 100
        && request.resource.data.dates is list && request.resource.data.dates.size() <= 120;
      allow delete: if false;
    }
    // No student/public reads until student authentication is separately released.
    match /lectureMaterialsBeta/{classId}/items/{itemId}{
      allow read: if isAdmin() || ownsClass(classId);
      allow create, update: if (isAdmin() || ownsClass(classId))
        && validClass(classId)
        && request.resource.data.classId == classId
        && request.resource.data.keys().hasOnly(['classId','lectureKey','lectureTitle','title','url','audience','updatedBy','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.lectureKey is string && request.resource.data.lectureKey.size() <= 500
        && request.resource.data.url is string && request.resource.data.url.size() <= 3000
        && request.resource.data.url.matches('https://(drive|docs)[.]google[.]com/.*')
        && request.resource.data.audience in ['students','staff']
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // settings: 관리자만 쓰고, 담임은 반이 없는 공용 문서(공지·시간표 강의 목록·설문 설정·동기화 상태)만 읽습니다.
    // 반별 문서(attendanceBeta_{반}_{날짜} 등)·체크히어 중계·기능 스위치는 관리자만 읽습니다.
    match /settings/{settingId}{
      allow read: if isAdmin() || (isTeacher() && settingId in ['global','timetableBetaCatalog','surveyBetaConfig','surveyAutoSync']);
      allow create, update, delete: if isAdmin();
    }
    // 그 밖의 경로는 모두 막습니다.
    match /{document=**}{
      allow read, write: if false;
    }
  }
}
