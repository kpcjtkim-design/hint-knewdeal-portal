rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null && request.auth.token.email != null;}
    function email(){return request.auth.token.email;}
    function bootstrapAdmin(){return signedIn()&&(email()=='hint.kpc@gmail.com'||email()=='kpc.jtkim@gmail.com');}
    function profileExists(){return signedIn()&&exists(/databases/$(database)/documents/users/$(email()));}
    function profile(){return get(/databases/$(database)/documents/users/$(email())).data;}
    function isAdmin(){return bootstrapAdmin()||(profileExists()&&profile().active==true&&profile().role=='ADMIN');}
    function isTeacher(){return profileExists()&&profile().active==true&&profile().role=='TEACHER';}
    function checkhereApprover(){return signedIn() && email()=='hint.kpc@gmail.com' && request.auth.token.email_verified==true && request.auth.token.firebase.sign_in_provider=='google.com';}
    function requestTeacherOwns(classId){
      let p = profile();
      let primary = p.get('primaryClassId',p.get('classId',''));
      let extra = p.get('tempClassIds',p.get('classIds',[]));
      return isTeacher() && (classId == primary || (extra is list && classId in extra));
    }
    function validChanges(c){
      return c is map && c.keys().size()>0 && c.keys().hasOnly(['entry','exit','entryMemo','exitMemo'])
        && (!('entry' in c) || (c.entry is string && c.entry.matches('([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]')))
        && (!('exit' in c) || (c.exit is string && c.exit.matches('([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]')))
        && (!('entryMemo' in c) || (c.entryMemo is string && c.entryMemo.size()<=500))
        && (!('exitMemo' in c) || (c.exitMemo is string && c.exitMemo.size()<=500));
    }
    match /checkhereRequests/{requestId}{
      allow read: if isAdmin() || (isTeacher() && resource.data.createdBy==email() && requestTeacherOwns(resource.data.classId));
      allow create: if signedIn() && request.auth.token.email_verified==true
        && (isAdmin() || requestTeacherOwns(request.resource.data.classId))
        && request.resource.data.keys().hasOnly(['classId','date','name','phoneLast4','reason','changes','createdBy','createdAt','updatedAt','status'])
        && request.resource.data.classId is string && request.resource.data.classId.matches('([1-9]|1[0-7])')
        && request.resource.data.date is string && request.resource.data.date.matches('2026-[0-9]{2}-[0-9]{2}')
        && request.resource.data.date>='2026-07-27' && request.resource.data.date<='2026-10-22'
        && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=60
        && request.resource.data.phoneLast4 is string && request.resource.data.phoneLast4.matches('([0-9]{4})?')
        && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=1000
        && validChanges(request.resource.data.changes)
        && request.resource.data.createdBy==email() && request.resource.data.status=='pending'
        && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
      allow update: if checkhereApprover() && request.resource.data.updatedAt==request.time && (
        (resource.data.status=='pending' && request.resource.data.status=='approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approval','approvedBy','approvedAt','updatedAt'])
          && request.resource.data.approvedBy==email() && request.resource.data.approvedAt==request.time
          && request.resource.data.approval is map
          && request.resource.data.approval.keys().hasOnly(['recordId','version','before','after','reason'])
          && request.resource.data.approval.recordId is string && request.resource.data.approval.version is string
          && request.resource.data.approval.reason==resource.data.reason
          && validChanges(request.resource.data.approval.after))
        || (resource.data.status=='pending' && request.resource.data.status=='rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','updatedAt'])
          && request.resource.data.reviewedBy==email() && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size()>0 && request.resource.data.reviewNote.size()<=1000)
        || (resource.data.status=='approved' && request.resource.data.status=='applying'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attemptId','updatedAt'])
          && request.resource.data.attemptId is string && request.resource.data.attemptId.size()>=16)
        || (resource.data.status=='applying' && request.resource.data.status in ['verified','partial','failed','unknown','conflict']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','result','updatedAt'])
          && request.resource.data.result is map && request.resource.data.result.message is string)
      );
      // Only pending requests can be withdrawn; request contents remain immutable.
      allow update: if signedIn() && request.auth.token.email_verified==true
        && resource.data.createdBy==email()
        && (isAdmin() || requestTeacherOwns(resource.data.classId))
        && resource.data.status=='pending' && request.resource.data.status=='withdrawn'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','withdrawnBy','withdrawnAt','updatedAt'])
        && request.resource.data.withdrawnBy==email()
        && request.resource.data.withdrawnAt==request.time && request.resource.data.updatedAt==request.time;
      allow delete: if false;
    }
    function teacherOwns(classId){
      return isTeacher() && (
        (profile().classId == classId) ||
        (profile().classIds is list && classId in profile().classIds)
      );
    }
    match /users/{userEmail}{
      allow read: if isAdmin() || (signedIn() && email()==userEmail);
      allow create, update, delete: if isAdmin();
    }
    match /classes/{classId}{
      allow read: if isAdmin() || teacherOwns(classId);
      allow create, update, delete: if isAdmin();
      match /checkhereSnapshots/{snapshotId}{
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.classId == classId
          && request.resource.data.createdBy == request.auth.token.email
          && request.resource.data.records is list
          && request.resource.data.records.size() <= 1000;
        allow update, delete: if false;
      }
      match /customLinks/{linkId}{
        allow read: if isAdmin() || teacherOwns(classId);
        allow create, update, delete: if isAdmin() || teacherOwns(classId);
      }
    }
    // Timetable beta data is isolated from attendance and production class settings.
    function timetableTeacherOwns(classId){
      let p = profile();
      return isTeacher() && (p.get('primaryClassId','') == classId || p.get('classId','') == classId
        || classId in p.get('classIds',[]) || classId in p.get('tempClassIds',[]));
    }
    function validTimetable(classId){
      return request.resource.data.classId == classId
        && classId.matches('([1-9]|1[0-7])')
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 500
        && request.resource.data.revision is int
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
    }
    match /timetableBetaDrafts/{classId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validTimetable(classId);
      allow delete: if false;
    }
    match /timetableBetaPublished/{classId}{
      allow read: if isAdmin() || timetableTeacherOwns(classId);
      allow create, update: if isAdmin() && validTimetable(classId);
      allow delete: if false;
    }
    match /timetableBetaInstructors/{instructorId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.name is string
        && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100
        && request.resource.data.keys().hasOnly(['name','organization','phone','note','revision','updatedBy','updatedAt'])
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Beta CheckHere proposals remain private to administrators. Sources are immutable.
    match /checkhereProposalDrafts/{draftId}{
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.classId is string
        && request.resource.data.classId.matches('([1-9]|1[0-7])')
        && request.resource.data.date is string
        && request.resource.data.students is map
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /checkhereProposalSources/{sourceId}{
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.requestId is string
        && request.resource.data.record is map
        && validChanges(request.resource.data.changes)
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    // Beta survey results: own-class reads, designated sync owner writes.
    match /surveyBetaSummaries/{classId}/surveys/{eventId}{
      allow read: if isAdmin() || timetableTeacherOwns(classId);
      allow create, update: if isAdmin()
        && request.auth.token.email_verified == true
        && email() == 'hint.kpc@gmail.com'
        && classId.matches('([1-9]|1[0-7])')
        && request.resource.data.classId == classId
        && request.resource.data.eventId == eventId
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['classId','eventId','title','date','sourceId','url','syncedAt','scheduleFingerprint','answered','missing','review','excluded','unknown','invalidCount','duplicateCount','eligibleCount','scores','attendanceFingerprint','updatedBy','updatedAt'])
        && request.resource.data.answered is list && request.resource.data.answered.size() <= 100
        && request.resource.data.missing is list && request.resource.data.missing.size() <= 100
        && request.resource.data.review is list && request.resource.data.review.size() <= 100
        && request.resource.data.excluded is list && request.resource.data.excluded.size() <= 100
        && request.resource.data.unknown is list && request.resource.data.unknown.size() <= 500;
      allow delete: if false;
    }

    // Class-scoped portal attendance derivation. Original Sheets remain unchanged.
    match /attendanceBetaSummaries/{classId}{
      allow read: if isAdmin() || timetableTeacherOwns(classId);
      allow create, update: if isAdmin()
        && classId.matches('([1-9]|1[0-7])')
        && request.resource.data.classId == classId
        && request.resource.data.updatedBy == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['classId','version','asOf','latestDate','latestEntered','dates','students','fingerprint','syncedAt','updatedBy','updatedAt'])
        && request.resource.data.students is list && request.resource.data.students.size() <= 100
        && request.resource.data.dates is list && request.resource.data.dates.size() <= 120;
      allow delete: if false;
    }
    // No student/public reads until student authentication is separately released.
    match /lectureMaterialsBeta/{classId}/items/{itemId}{
      allow read: if isAdmin() || timetableTeacherOwns(classId);
      allow create, update: if (isAdmin() || timetableTeacherOwns(classId))
        && classId.matches('([1-9]|1[0-7])')
        && request.resource.data.classId == classId
        && request.resource.data.keys().hasOnly(['classId','lectureKey','lectureTitle','title','url','audience','updatedBy','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.lectureKey is string && request.resource.data.lectureKey.size() <= 500
        && request.resource.data.url is string && request.resource.data.url.size() <= 3000
        && request.resource.data.url.matches('https://(drive|docs)[.]google[.]com/.*')
        && request.resource.data.audience in ['students','staff']
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/{settingId}{
      allow read: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }
  }
}
