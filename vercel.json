{
  "functions": {
    "api/attendance-reader.js": {"maxDuration": 60},
    "api/attendance-colors.js": {"maxDuration": 60},
    "api/survey-sync.js": {"maxDuration": 60},
    "api/teacher-beta.js": {"maxDuration": 60}
  },
  "redirects": [
    {
      "source": "/scan-guide.jpg",
      "destination": "/scan-guide.svg",
      "permanent": false
    }
  ],
  "rewrites": [
    {"source": "/beta2", "destination": "/index.html"},
    {"source": "/beta2/", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/beta2", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/beta2/", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "Cache-Control", "value": "no-store"}]}
  ]
}
