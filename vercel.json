{
  "functions": {
    "api/teacher-beta.js": {"maxDuration": 60}
  },
  "redirects": [
    {
      "source": "/scan-guide.jpg",
      "destination": "/scan-guide.svg",
      "permanent": false
    },
    {"source": "/beta2", "destination": "/", "permanent": false},
    {"source": "/beta2/", "destination": "/", "permanent": false}
  ],
  "rewrites": [
    {"source": "/old", "destination": "/api/old"},
    {"source": "/old/:path*", "destination": "/api/old?path=:path*"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
